{
  "realm": "backend-lab",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "reader"
      },
      {
        "name": "admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lab-reader",
      "secret": "lab-reader-local-only",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "backend-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lab-admin",
      "secret": "lab-admin-local-only",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "backend-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-lab-reader",
      "enabled": true,
      "serviceAccountClientId": "lab-reader",
      "realmRoles": [
        "reader"
      ]
    },
    {
      "username": "service-account-lab-admin",
      "enabled": true,
      "serviceAccountClientId": "lab-admin",
      "realmRoles": [
        "admin"
      ]
    }
  ]
}